# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Secrets — NEVER commit these
.env
.env.local
.env.production
.env.staging
*.p12
*.p8
serviceAccountKey*.json
google-services.json
GoogleService-Info.plist

# Firebase
.firebase/
firebase-debug.log
.runtimeconfig.json
firestore-debug.log
storage.rules.debug
ui-debug.log

# Node / Cloud Functions
node_modules/
functions/node_modules/
functions/lib/
functions/.env
functions/.env.production

# Flutter platform build artifacts
flutter_app/.dart_tool/
flutter_app/.flutter-plugins
flutter_app/.flutter-plugins-dependencies
